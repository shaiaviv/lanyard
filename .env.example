# Lanyard — environment variables
# Only INFRA/bootstrap keys live here (they're needed before the app can read its own DB).
# SERVICE keys (Anthropic, OpenAI/Whisper, enrichment, HubSpot) are configured in-app via
# Settings (encrypted, server-side only). See plans/tech/00-tech-foundation.md §6.

# --- Supabase (infra — required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Secret used to encrypt service keys stored in app_settings (infra — required) ---
SETTINGS_ENCRYPTION_SECRET=

# --- Optional dev fallback for service keys (Settings is the primary source in production) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ENRICHMENT_API_KEY=
# HUBSPOT_API_KEY=
